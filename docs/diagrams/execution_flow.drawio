<mxfile host="app.diagrams.net" modified="2026-11-23T12:27:00.000Z" agent="sysadmin-tools" version="24.0.0" type="device">
  <diagram id="exec-flow" name="Execution Lifecycle">
    <mxGraphModel dx="1422" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="ef_title" value="Execution Lifecycle: Two-Snapshot Delta Sampling &amp; Per-Disk Lock Guard" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1420" height="44" as="geometry" />
        </mxCell>

        <!-- Top Swimlane: Two-Snapshot Delta Sampling -->
        <mxCell id="lane_delta" value="A. Two-Snapshot Monotonic Delta Sampling (sys-investigate &amp; sys-mem-watch)" style="swimlane;whiteSpace=wrap;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="84" width="1420" height="360" as="geometry" />
        </mxCell>

        <mxCell id="d_step1" value="1. CLI Argparse&#xa;--interval, --json&#xa;--diagnose-pid&#xa;--progress-check&#xa;--no-statvfs" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="lane_delta">
          <mxGeometry x="25" y="65" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_step2" value="2. Snapshot T0&#xa;t0 = time.monotonic()&#xa;Read /proc/stat, vmstat,&#xa;pressure/*, diskstats,&#xa;/proc/&lt;pid&gt; + starttime" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="lane_delta">
          <mxGeometry x="245" y="65" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_step3" value="3. Monotonic Wait&#xa;Sleep interval dt&#xa;(or multi-sample&#xa;--progress-check loop)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="lane_delta">
          <mxGeometry x="495" y="65" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_step4" value="4. Snapshot T1&#xa;t1 = time.monotonic()&#xa;Re-read /proc &amp; /sys&#xa;NVMe hwmon thermals&#xa;(skip statvfs if flagged)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="lane_delta">
          <mxGeometry x="715" y="65" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_step5" value="5. Delta &amp; Classify&#xa;Match PID starttime&#xa;Compute CPU/IO/Swap/RSS&#xa;Bottleneck + Productivity&#xa;or Memory Verdict" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="lane_delta">
          <mxGeometry x="965" y="65" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_step6" value="6. Emit &amp; Exit&#xa;Human / --json /&#xa;--append-log&#xa;Exit 0 (Healthy)&#xa;Exit 3 (--exit-on-issue)" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_delta">
          <mxGeometry x="1215" y="65" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_note" value="Invariant: Zero subprocess spawning during T0/T1 sampling. All reads hit in-memory /proc and /sys so diagnostics complete even when secondary NVMe disks are 99%+ saturated." style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="lane_delta">
          <mxGeometry x="25" y="220" width="1370" height="90" as="geometry" />
        </mxCell>

        <!-- Delta connectors -->
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_delta" source="d_step1" target="d_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_delta" source="d_step2" target="d_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_delta" source="d_step3" target="d_step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_delta" source="d_step4" target="d_step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_delta" source="d_step5" target="d_step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bottom Swimlane: sys-io-guard Lock Lifecycle -->
        <mxCell id="lane_guard" value="B. sys-io-guard Per-Disk Lock Acquisition, Execution &amp; Contention Lifecycle" style="swimlane;whiteSpace=wrap;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="470" width="1420" height="420" as="geometry" />
        </mxCell>

        <mxCell id="g_step1" value="1. Resolve Target Path&#xa;Read /proc/mounts&#xa;(longest mount prefix)" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="lane_guard">
          <mxGeometry x="25" y="70" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g_step2" value="2. Physical Disk Key&#xa;Walk /sys/block/dm-*/slaves&#xa;Map LVM/LUKS to backing&#xa;physical NVMe/SATA disk" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="lane_guard">
          <mxGeometry x="255" y="70" width="210" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g_step3" value="3. Non-Blocking Flock&#xa;Lockfile in tmpfs:&#xa;$XDG_RUNTIME_DIR/sys-io-guard&#xa;fcntl.flock(LOCK_EX | LOCK_NB)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="lane_guard">
          <mxGeometry x="505" y="70" width="230" height="95" as="geometry" />
        </mxCell>

        <!-- Acquired branch -->
        <mxCell id="g_acq1" value="4a. Lock Acquired&#xa;Write &lt;disk&gt;.lock.meta&#xa;(PID, argv, timestamp)&#xa;Cap CARGO_BUILD_JOBS&#xa;Apply os.nice" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="lane_guard">
          <mxGeometry x="810" y="55" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="g_acq2" value="5a. Execute &amp; Release&#xa;Direct subprocess.run(cmd,&#xa;shell=False)&#xa;Release flock + remove .meta&#xa;Propagate child exit code" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_guard">
          <mxGeometry x="1110" y="55" width="275" height="115" as="geometry" />
        </mxCell>

        <!-- Contended branch -->
        <mxCell id="g_busy1" value="4b. EWOULDBLOCK (Busy)&#xa;Read &lt;disk&gt;.lock.meta&#xa;Identify active holder&#xa;Retry poll until --timeout" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="lane_guard">
          <mxGeometry x="810" y="235" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="g_busy2" value="5b. Timeout Expired&#xa;Print holder PID/cmd/age&#xa;to stderr&#xa;EXIT 4 (Lock Busy / Timeout)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_guard">
          <mxGeometry x="1110" y="235" width="275" height="115" as="geometry" />
        </mxCell>

        <!-- Guard connectors -->
        <mxCell id="ge1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_guard" source="g_step1" target="g_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_guard" source="g_step2" target="g_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge3" value="Acquired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontStyle=1;" edge="1" parent="lane_guard" source="g_step3" target="g_acq1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="lane_guard" source="g_acq1" target="g_acq2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge5" value="Busy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontStyle=1;" edge="1" parent="lane_guard" source="g_step3" target="g_busy1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge6" value="Timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontStyle=1;" edge="1" parent="lane_guard" source="g_busy1" target="g_busy2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge7" value="Acquired on retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="lane_guard" source="g_busy1" target="g_acq1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
